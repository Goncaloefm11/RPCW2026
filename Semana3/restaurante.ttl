###  http://www.semanticweb.org/gugafm11/ontologies/2026/untitled-ontology-11#Aristóteles
:Aristóteles rdf:type owl:NamedIndividual ,
                      [ owl:intersectionOf ( :Funcionário
                                             :Polvo
                                           ) ;
                        rdf:type owl:Class
                      ] ;
             :trabalhamEm :O_Polvo_Filosófico .


###  http://www.semanticweb.org/gugafm11/ontologies/2026/untitled-ontology-11#O_Polvo_Filosófico
:O_Polvo_Filosófico rdf:type owl:NamedIndividual ,
                             :Restaurante ;
                    :contêmPrato :massaOriental ,
                                 :rissoto_de_ervas ,
                                 :t-bone .


###  http://www.semanticweb.org/gugafm11/ontologies/2026/untitled-ontology-11#RoboCozinheiro
:RoboCozinheiro rdf:type owl:NamedIndividual ,
                         [ owl:intersectionOf ( :Cozinheiro
                                                :Máquina
                                              ) ;
                           rdf:type owl:Class
                         ] ;
                :trabalhamEm :O_Polvo_Filosófico .


###  http://www.semanticweb.org/gugafm11/ontologies/2026/untitled-ontology-11#Schrodinger
:Schrodinger rdf:type owl:NamedIndividual ,
                      [ owl:intersectionOf ( :Cliente
                                             :Gato
                                           ) ;
                        rdf:type owl:Class
                      ] ;
             :comem :rissoto_de_ervas .


