@prefix : <http://www.semanticweb.org/gugafm11/ontologies/2026/untitled-ontology-23#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xml: <http://www.w3.org/XML/1998/namespace> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@base <http://www.semanticweb.org/gugafm11/ontologies/2026/familia> .

<http://www.semanticweb.org/gugafm11/ontologies/2026/familia> rdf:type owl:Ontology .

#################################################################
#    Object Properties
#################################################################

###  http://www.semanticweb.org/gugafm11/ontologies/2026/familia#eProgenitorGrau2
:eProgenitorGrau2 rdf:type owl:ObjectProperty ;
                  rdfs:subPropertyOf :eAntepassadoDe .


###  http://www.semanticweb.org/gugafm11/ontologies/2026/familia#temIrmao
:temIrmao rdf:type owl:ObjectProperty ;
          rdfs:subPropertyOf :temRelacaoSangue ;
          rdf:type owl:SymmetricProperty ,
                   owl:TransitiveProperty ;
          owl:propertyChainAxiom ( :temProgenitor
                                   :eProgenitorDe
                                 ) .


###  http://www.semanticweb.org/gugafm11/ontologies/2026/familia#temPrimo
:temPrimo rdf:type owl:ObjectProperty ;
          rdfs:subPropertyOf :temRelacaoSangue ;
          rdf:type owl:SymmetricProperty ;
          owl:propertyChainAxiom ( :temProgenitor
                                   :temProgenitor
                                   :eProgenitorDe
                                   :eProgenitorDe
                                 ) .


###  http://www.semanticweb.org/gugafm11/ontologies/2026/familia#temRelacaoSangue
:temRelacaoSangue rdf:type owl:ObjectProperty ;
                  rdfs:subPropertyOf :temRelacao .


###  http://www.semanticweb.org/gugafm11/ontologies/2026/untitled-ontology-23#eAntepassadoDe
:eAntepassadoDe rdf:type owl:ObjectProperty ;
                rdfs:subPropertyOf :temRelacao ;
                owl:inverseOf :temAntepassado .


###  http://www.semanticweb.org/gugafm11/ontologies/2026/untitled-ontology-23#eMaeDe
:eMaeDe rdf:type owl:ObjectProperty ;
        rdfs:subPropertyOf :eProgenitorDe ;
        owl:inverseOf :temMae .


###  http://www.semanticweb.org/gugafm11/ontologies/2026/untitled-ontology-23#ePaiDe
:ePaiDe rdf:type owl:ObjectProperty ;
        rdfs:subPropertyOf :eProgenitorDe ;
        owl:inverseOf :temPai .


###  http://www.semanticweb.org/gugafm11/ontologies/2026/untitled-ontology-23#eProgenitorDe
:eProgenitorDe rdf:type owl:ObjectProperty ;
               rdfs:subPropertyOf :eAntepassadoDe ;
               owl:inverseOf :temProgenitor .


###  http://www.semanticweb.org/gugafm11/ontologies/2026/untitled-ontology-23#temAntepassado
:temAntepassado rdf:type owl:ObjectProperty ;
                rdfs:subPropertyOf :temRelacaoSangue ;
                rdf:type owl:TransitiveProperty .


###  http://www.semanticweb.org/gugafm11/ontologies/2026/untitled-ontology-23#temAvoF
:temAvoF rdf:type owl:ObjectProperty ;
         rdfs:subPropertyOf :temProgenitorGrau2 ;
         owl:propertyChainAxiom ( :temProgenitor
                                  :temMae
                                ) .


###  http://www.semanticweb.org/gugafm11/ontologies/2026/untitled-ontology-23#temAvoM
:temAvoM rdf:type owl:ObjectProperty ;
         rdfs:subPropertyOf :temProgenitorGrau2 ;
         owl:propertyChainAxiom ( :temProgenitor
                                  :temPai
                                ) .


###  http://www.semanticweb.org/gugafm11/ontologies/2026/untitled-ontology-23#temMae
:temMae rdf:type owl:ObjectProperty ;
        rdfs:subPropertyOf :temProgenitor ;
        rdfs:domain :Pessoa ;
        rdfs:range :Mulher .


###  http://www.semanticweb.org/gugafm11/ontologies/2026/untitled-ontology-23#temPai
:temPai rdf:type owl:ObjectProperty ;
        rdfs:subPropertyOf :temProgenitor ;
        rdfs:domain :Pessoa ;
        rdfs:range :Homem .


###  http://www.semanticweb.org/gugafm11/ontologies/2026/untitled-ontology-23#temProgenitor
:temProgenitor rdf:type owl:ObjectProperty ;
               rdfs:subPropertyOf :temAntepassado ;
               rdfs:domain :Pessoa ;
               rdfs:range :Pessoa .


###  http://www.semanticweb.org/gugafm11/ontologies/2026/untitled-ontology-23#temProgenitorGrau2
:temProgenitorGrau2 rdf:type owl:ObjectProperty ;
                    rdfs:subPropertyOf :temAntepassado ;
                    owl:propertyChainAxiom ( :temProgenitorGrau2
                                             :eProgenitorGrau2
                                           ) .


###  http://www.semanticweb.org/gugafm11/ontologies/2026/untitled-ontology-23#temRelacao
:temRelacao rdf:type owl:ObjectProperty ,
                     owl:SymmetricProperty .


###  http://www.semanticweb.org/gugafm11/ontologies/2026/untitled-ontology-23#temSexo
:temSexo rdf:type owl:ObjectProperty ,
                  owl:FunctionalProperty ;
         rdfs:domain :Pessoa ;
         rdfs:range :Sexo .


#################################################################
#    Classes
#################################################################

###  http://www.semanticweb.org/gugafm11/ontologies/2026/familia#AntePassadoFem
:AntePassadoFem rdf:type owl:Class ;
                owl:equivalentClass [ owl:intersectionOf ( :Antepassado
                                                           :Mulher
                                                         ) ;
                                      rdf:type owl:Class
                                    ] .


###  http://www.semanticweb.org/gugafm11/ontologies/2026/familia#Antepassado
:Antepassado rdf:type owl:Class ;
             owl:equivalentClass [ owl:intersectionOf ( :Pessoa
                                                        [ rdf:type owl:Restriction ;
                                                          owl:onProperty :eAntepassadoDe ;
                                                          owl:someValuesFrom :Pessoa
                                                        ]
                                                      ) ;
                                   rdf:type owl:Class
                                 ] .


###  http://www.semanticweb.org/gugafm11/ontologies/2026/familia#AntepassadoMasc
:AntepassadoMasc rdf:type owl:Class ;
                 owl:equivalentClass [ owl:intersectionOf ( :Antepassado
                                                            :Homem
                                                          ) ;
                                       rdf:type owl:Class
                                     ] .


###  http://www.semanticweb.org/gugafm11/ontologies/2026/familia#Descendente
:Descendente rdf:type owl:Class ;
             owl:equivalentClass [ owl:intersectionOf ( :Pessoa
                                                        [ rdf:type owl:Restriction ;
                                                          owl:onProperty :temAntepassado ;
                                                          owl:someValuesFrom :Pessoa
                                                        ]
                                                      ) ;
                                   rdf:type owl:Class
                                 ] .


###  http://www.semanticweb.org/gugafm11/ontologies/2026/familia#DescendenteFem
:DescendenteFem rdf:type owl:Class ;
                owl:equivalentClass [ owl:intersectionOf ( :Descendente
                                                           :Mulher
                                                         ) ;
                                      rdf:type owl:Class
                                    ] .


###  http://www.semanticweb.org/gugafm11/ontologies/2026/familia#DescendenteMasc
:DescendenteMasc rdf:type owl:Class ;
                 owl:equivalentClass [ owl:intersectionOf ( :Descendente
                                                            :Homem
                                                          ) ;
                                       rdf:type owl:Class
                                     ] .


###  http://www.semanticweb.org/gugafm11/ontologies/2026/untitled-ontology-23#DominioFamiliar
:DominioFamiliar rdf:type owl:Class .


###  http://www.semanticweb.org/gugafm11/ontologies/2026/untitled-ontology-23#Feminio
:Feminio rdf:type owl:Class ;
         rdfs:subClassOf :Sexo ;
         owl:disjointWith :Masculino .


###  http://www.semanticweb.org/gugafm11/ontologies/2026/untitled-ontology-23#Homem
:Homem rdf:type owl:Class ;
       rdfs:subClassOf :Pessoa ,
                       [ rdf:type owl:Restriction ;
                         owl:onProperty :temSexo ;
                         owl:someValuesFrom :Masculino
                       ] ;
       owl:disjointWith :Mulher .


###  http://www.semanticweb.org/gugafm11/ontologies/2026/untitled-ontology-23#Masculino
:Masculino rdf:type owl:Class ;
           rdfs:subClassOf :Sexo .


###  http://www.semanticweb.org/gugafm11/ontologies/2026/untitled-ontology-23#Mulher
:Mulher rdf:type owl:Class ;
        rdfs:subClassOf :Pessoa ,
                        [ rdf:type owl:Restriction ;
                          owl:onProperty :temSexo ;
                          owl:someValuesFrom :Feminio
                        ] .


###  http://www.semanticweb.org/gugafm11/ontologies/2026/untitled-ontology-23#Pessoa
:Pessoa rdf:type owl:Class ;
        rdfs:subClassOf :DominioFamiliar ,
                        [ rdf:type owl:Class ;
                          owl:unionOf ( :Homem
                                        :Mulher
                                      )
                        ] ,
                        [ rdf:type owl:Restriction ;
                          owl:onProperty :temMae ;
                          owl:someValuesFrom :Mulher
                        ] ,
                        [ rdf:type owl:Restriction ;
                          owl:onProperty :temPai ;
                          owl:someValuesFrom :Homem
                        ] ,
                        [ rdf:type owl:Restriction ;
                          owl:onProperty :temSexo ;
                          owl:someValuesFrom :Sexo
                        ] ;
        owl:disjointWith :Sexo .


###  http://www.semanticweb.org/gugafm11/ontologies/2026/untitled-ontology-23#Sexo
:Sexo rdf:type owl:Class ;
      rdfs:subClassOf :DominioFamiliar ,
                      [ rdf:type owl:Class ;
                        owl:unionOf ( :Feminio
                                      :Masculino
                                    )
                      ] .


