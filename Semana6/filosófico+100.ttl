:CarneDeSísifo a :IngredienteAnimal .
:OvoDeColombo a :IngredienteAnimal .
:PolvoGrelhadoIngrediente a :IngredienteAnimal , :Polvo .
:LulaCartesiana a :IngredienteAnimal .

############################################################
# 4. PRATOS (15 Indivíduos)
############################################################

:SopaDeNada a :PratoVegano ; :temIngrediente :AlgaFenomenologica , :SalDoNiilismo .
:BanquetePlatonico a :PratoVegano ; :temIngrediente :EssenciaDeSoja , :MelDasIdeias .
:PaoDaRazao a :PratoVegano ; :temIngrediente :TrigoRacional , :FermentoDialetico .
:SaladaDeSombras a :PratoVegano ; :temIngrediente :AguaDaCaverna , :Alface .
:HamburguerDoImperativo a :PratoCarnivoro ; :temIngrediente :CarneVaca , :PimentaDoCaos .
:GrelhadoDeExistencia a :PratoCarnivoro ; :temIngrediente :CarneDeSísifo .
:OmeleteDoConhecimento a :PratoCarnivoro ; :temIngrediente :OvoDeColombo .
:BacalhauDaAngustia a :PratoCarnivoro ; :temIngrediente :PeixeKierkegaard .
:SushisDeHeraclito a :PratoOntologicamenteAmbiguo ; :temIngrediente :Peixe , :Tofu .
:LasanhaDualista a :PratoOntologicamenteAmbiguo ; :temIngrediente :CarneVaca , :EssenciaDeSoja .
:CaldoDoDevir a :PratoOntologicamenteAmbiguo ; :temIngrediente :LulaCartesiana , :Cogumelos .
:PastaDoInconsciente a :PratoOntologicamenteAmbiguo ; :temIngrediente :CarneVaca , :Tofu .
:RisotoDaDuvida a :PratoOntologicamenteAmbiguo ; :temIngrediente :Peixe , :LeiteDeAmendoa .
:CarpaccioDePolvo a :PratoCarnivoro ; :temIngrediente :PolvoGrelhadoIngrediente .
:FricasseParadoxal a :PratoOntologicamenteAmbiguo ; :temIngrediente :CarneDeSísifo , :Tofu .

############################################################
# 5. PEDIDOS E CONSUMO (20 Indivíduos)
############################################################

:Pedido6 a :Pedido ; :contemPrato :SopaDeNada ; :feitoPor :Diogenes .
:Pedido7 a :Pedido ; :contemPrato :BanquetePlatonico ; :feitoPor :Epicuro .
:Pedido8 a :Pedido ; :contemPrato :HamburguerDoImperativo ; :feitoPor :Socrates .
:Pedido9 a :Pedido ; :contemPrato :SushisDeHeraclito ; :feitoPor :Heraclito .
:Pedido10 a :Pedido ; :contemPrato :CarpaccioDePolvo ; :feitoPor :PolvoPaulo .
:Pedido11 a :Pedido ; :contemPrato :PaoDaRazao ; :feitoPor :Platao .
:Pedido12 a :Pedido ; :contemPrato :GrelhadoDeExistencia ; :feitoPor :Parmenides .
:Pedido13 a :Pedido ; :contemPrato :OmeleteDoConhecimento ; :feitoPor :Democrito .
:Pedido14 a :Pedido ; :contemPrato :SaladaDeSombras ; :feitoPor :Pitagoras .
:Pedido15 a :Pedido ; :contemPrato :CaldoDoDevir ; :feitoPor :Anaximandro .
:Pedido16 a :Pedido ; :contemPrato :LasanhaDualista ; :feitoPor :Cliente_01 .
:Pedido17 a :Pedido ; :contemPrato :RisotoDaDuvida ; :feitoPor :Cliente_02 .
:Pedido18 a :Pedido ; :contemPrato :FricasseParadoxal ; :feitoPor :Cliente_03 .
:Pedido19 a :Pedido ; :contemPrato :BacalhauDaAngustia ; :feitoPor :Cliente_04 .
:Pedido20 a :Pedido ; :contemPrato :SopaDeNada ; :feitoPor :Cliente_05 .

# Relações de Consumo (:come)
:Diogenes :come :SopaDeNada .
:Epicuro :come :BanquetePlatonico .
:Socrates :come :HamburguerDoImperativo .
:Heraclito :come :SushisDeHeraclito .
:PolvoPaulo :come :CarpaccioDePolvo . # Inconsistência: Polvo comendo Polvo